# Copy to .env and fill in. Never commit .env.
# SQLite file (relative to apps/api in development; in Docker: file:/data/bugtool.db)
DATABASE_URL=file:../../data/bugtool.db
API_PORT=4000
# Public URL of the API (used in DSNs) and of the dashboard (used in invite and alert links)
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# First admin, created on startup only while the database has no users (ignored afterwards).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-min-10-chars

# OpenTelemetry (optional; all variables are listed in docs/self-hosting.md#configuration)
# OTLP_GRPC_PORT=4317            # 0 turns the gRPC receiver off
# OTLP_LOG_RETENTION_DAYS=3      # Lite mode log retention
# TELEMETRY_STORE=sqlite         # or clickhouse (Scale mode)
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USER=bugtrail
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=bugtrail
