# Copy ke .env lalu isi. Jangan commit .env.
# Path file SQLite (relatif ke apps/api saat dev; di Docker: file:/data/bugtool.db)
DATABASE_URL=file:../../data/bugtool.db
API_PORT=4000
# URL publik API (dipakai di DSN) dan URL web (link undangan)
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# First admin, created on startup only while the database has no users (ignored afterwards).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-min-10-chars
